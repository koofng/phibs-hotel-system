    {
      "name": "Public Booking (no auth)",
      "item": [
        {
          "name": "List room types",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/public/room-types", "host": ["{{baseUrl}}"], "path": ["public", "room-types"] },
            "description": "No authentication required — the guest-facing browse endpoint."
          }
