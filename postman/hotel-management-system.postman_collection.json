    {
      "name": "Billing",
      "item": [
        {
          "name": "List all payments (Admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/payments?dateFrom=&dateTo=&method=&guestId=",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "payments"],
              "query": [
                { "key": "dateFrom", "value": "", "description": "ISO date string" },
                { "key": "dateTo", "value": "", "description": "ISO date string" },
                { "key": "method", "value": "", "description": "CASH | CARD | TRANSFER" },
                { "key": "guestId", "value": "" }
              ]
            },
            "description": "Admin-only. Every payment across all bookings, with the linked reservation/guest/room and the folio's line items (room charges + services like ironing, laundry, food & drinks, room service) so you can see what each payment was for."
          }
        },
        {
          "name": "Get folio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/folios/{{folioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "folios", "{{folioId}}"]
            }
          }
        },
        {
          "name": "Add line item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const items = body.folio.lineItems;",
                  "  if (items && items.length) {",
                  "    pm.collectionVariables.set('lineItemId', items[items.length - 1].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SERVICE\",\n  \"description\": \"Minibar\",\n  \"amount\": 15,\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/billing/folios/{{folioId}}/line-items",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "folios", "{{folioId}}", "line-items"]
            },
            "description": "type: ROOM_CHARGE | SERVICE | TAX | DISCOUNT"
          }
        },
        {
          "name": "Remove line item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/folios/{{folioId}}/line-items/{{lineItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "folios", "{{folioId}}", "line-items", "{{lineItemId}}"]
            }
          }
        },
        {
          "name": "Add payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100,\n  \"method\": \"CARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/billing/folios/{{folioId}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "folios", "{{folioId}}", "payments"]
            },
            "description": "method: CASH | CARD | TRANSFER"
          }
        },
        {
          "name": "Generate invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.folio.invoice) {",
                  "    pm.collectionVariables.set('invoiceId', body.folio.invoice.id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/folios/{{folioId}}/invoice",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "folios", "{{folioId}}", "invoice"]
            },
            "description": "Closes the folio and computes subtotal/tax/total/balanceDue."
          }
        },
        {
          "name": "Get invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/billing/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["billing", "invoices", "{{invoiceId}}"]
            }
          }
        }
