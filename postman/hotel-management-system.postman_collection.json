          "name": "Search availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.rooms && body.rooms.length) {",
                  "    pm.collectionVariables.set('publicRoomId', body.rooms[0].id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/rooms/availability?checkIn=2027-01-10&checkOut=2027-01-13",
              "host": ["{{baseUrl}}"],
              "path": ["public", "rooms", "availability"],
              "query": [
                { "key": "checkIn", "value": "2027-01-10" },
                { "key": "checkOut", "value": "2027-01-13" }
              ]
            },
            "description": "No authentication required. Saves the first available room's id into {{publicRoomId}}."
          }
